{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wendellrowe-site",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "routes": [
    {
      "pattern": "wendellrowe.com",
      "custom_domain": true
    },
    {
      "pattern": "www.wendellrowe.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
